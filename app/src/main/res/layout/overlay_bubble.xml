<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubbleRoot"
    android:layout_width="64dp"
    android:layout_height="64dp"
    android:background="@drawable/bg_bubble"
    android:contentDescription="@string/bubble_description"
    android:elevation="8dp"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:id="@+id/bubbleLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bubble_label"
        android:textColor="@color/on_accent"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
